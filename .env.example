# Variáveis do ambiente Docker.
#
# Copie para `.env` antes de subir os containers:
#
#   cp .env.example .env
#
# Nenhuma senha real deve ser escrita aqui. O valor abaixo é de
# demonstração e vale apenas para o ambiente local de avaliação.

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
APP_NAME="Nogle CRUD"
APP_ENV=production
APP_DEBUG=false

# Porta em que a aplicação fica acessível no seu computador.
# 8080 porque 80 e 8000 costumam estar ocupados.
APP_PORT=8080
APP_URL=http://localhost:8080

# Chave de criptografia da sessão.
#
# Deixe em branco: na primeira subida ela é gerada e guardada no volume de
# storage, de modo que persiste entre reinícios sem precisar estar no
# repositório. Para fixá-la você mesmo:
#
#   docker compose run --rm app php artisan key:generate --show
#
APP_KEY=

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
DB_DATABASE=nogle_crud
DB_USERNAME=nogle

# Senha do banco. OBRIGATÓRIA e deliberadamente vazia.
#
# O compose recusa subir enquanto ela estiver em branco. Deixar aqui uma
# senha de exemplo que funcionasse seria pior do que exigir a escolha: todo
# mundo subiria com a mesma senha conhecida, e ninguém notaria.
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Sessão
# ---------------------------------------------------------------------------
# Origem do navegador, tratada como sessão pelo Sanctum. Precisa coincidir
# com APP_PORT.
SANCTUM_STATEFUL_DOMAINS=localhost:8080

# `true` apenas sob HTTPS. Em HTTP local, marcá-lo impediria o navegador de
# enviar o cookie e o login nunca completaria.
SESSION_SECURE_COOKIE=false
SESSION_DOMAIN=null

# ---------------------------------------------------------------------------
# Demonstração
# ---------------------------------------------------------------------------
# Semeia 52 clientes fictícios e os dois usuários de demonstração na
# primeira subida. Dados já existentes não são duplicados.
SEED_DEMO_DATA=true
