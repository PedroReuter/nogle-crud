# Destino do proxy de desenvolvimento do Vite.
#
# O Vite encaminha /api para este endereço, mantendo o SPA e a API na mesma
# origem durante o desenvolvimento. Isso dispensa CORS e, a partir da Etapa 3,
# evita cookie de sessão cross-site — que exigiria SameSite=None com Secure e,
# portanto, HTTPS também em desenvolvimento.
#
# Só é necessário alterar se o backend estiver em outra porta.
VITE_API_PROXY_TARGET=http://127.0.0.1:8001
