APP_NAME="Nogle CRUD"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=nogle_crud
DB_USERNAME=nogle
DB_PASSWORD=

# Banco usado pela suite de testes. Precisa ser distinto do banco de
# desenvolvimento: a suite trunca as tabelas entre os testes.
DB_TEST_DATABASE=nogle_crud_test

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Origem do SPA, usada por CORS e pelos dominios stateful do Sanctum.
# Em desenvolvimento o Vite faz proxy de /api para o backend, mantendo
# front e API na mesma origem; esta variavel cobre o caso de o avaliador
# preferir servir o frontend direto na porta do Vite.
FRONTEND_URL=http://localhost:5174

# ----------------------------------------------------------------------
# Autenticação
# ----------------------------------------------------------------------
# Domínios cujo acesso à API é tratado como sessão (Sanctum em modo SPA).
# Precisa conter a origem de onde o navegador carrega o SPA — em
# desenvolvimento, a porta do Vite. Uma origem fora desta lista é tratada
# como requisição stateless e não recebe sessão.
SANCTUM_STATEFUL_DOMAINS=localhost:5174,127.0.0.1:5174

# Domínio do cookie de sessão. `null` emite cookie host-only, válido apenas
# para o host exato que o servidor respondeu — o comportamento mais restrito
# e o correto para origem única.
SESSION_DOMAIN=null

# Cookie de sessão apenas sobre HTTPS. Falso em desenvolvimento, onde não há
# TLS; em produção precisa ser true, senão o cookie trafega em claro.
SESSION_SECURE_COOKIE=false

# Impede o envio do cookie em navegação cross-site, que é a defesa de
# primeira linha contra CSRF.
SESSION_SAME_SITE=lax
